NODE_ENV=development
PORT=3000

# Database
# Use the Prisma schema path defined in infrastructure/database
DATABASE_URL="postgresql://user:password@localhost:5432/abos_db?schema=public"

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Security / CORS
CORS_ORIGIN=http://localhost:3001

# JWT Authentication
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=10
